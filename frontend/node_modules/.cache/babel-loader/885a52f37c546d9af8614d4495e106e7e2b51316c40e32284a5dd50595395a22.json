{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { Chart as ChartJS, Title, Tooltip, Legend, BarElement, CategoryScale, LinearScale } from 'chart.js';\nimport { Bar } from 'vue-chartjs';\nChartJS.register(CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend);\nexport default {\n  name: 'ChartView',\n  components: {\n    Bar\n  },\n  props: {\n    products: {\n      type: String,\n      required: true\n    }\n  },\n  computed: {\n    chartData() {\n      return {\n        labels: this.products.map(item => `${item.brand} - (${item.model})`),\n        datasets: [{\n          label: 'Score (0-100)',\n          backgroundColor: '#2563eb',\n          data: this.products.map(item => item.score)\n        }, {\n          label: 'TTR (Days)',\n          backgroundColor: '#f59e0b',\n          data: this.products.map(item => item.ttr_days)\n        }]\n      };\n    },\n    chartOptions() {\n      return {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n          legend: {\n            position: 'top'\n          },\n          tooltip: {\n            enabled: true\n          }\n        },\n        scales: {\n          y: {\n            beginAtZero: true\n          }\n        }\n      };\n    }\n  }\n};","map":{"version":3,"names":["Chart","ChartJS","Title","Tooltip","Legend","BarElement","CategoryScale","LinearScale","Bar","register","name","components","props","products","type","String","required","computed","chartData","labels","map","item","brand","model","datasets","label","backgroundColor","data","score","ttr_days","chartOptions","responsive","maintainAspectRatio","plugins","legend","position","tooltip","enabled","scales","y","beginAtZero"],"sources":["/Users/chill/Documents/ICRT/ICRT_task/src/components/ChartView.vue"],"sourcesContent":["<template>\n    <div class=\"chart-wrapper\">\n        <div class=\"chart-box\" :class=\"{ 'is-blurred': selectedTier === 'basic' }\">\n            <Bar :data=\"chartData\" :options=\"chartOptions\" />\n        </div>\n\n        <div v-if=\"selectedTier === 'basic'\" class=\"gate-overlay\">\n            <div class=\"gate-card\">\n                <span class=\"gate-icon\">🔒</span>\n                <h3>Detailed Chart Locked</h3>\n                <p>You are on the <strong>Basic Tier</strong>. Upgrade to <strong>Premium</strong> or\n                    <strong>Enterprise</strong> to interact with granular product charts.\n                </p>\n                <button class=\"btn-upgrade\" @click=\"selectedTier = 'Premium'\">\n                    Switch to Premium\n                </button>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nimport {\n    Chart as ChartJS,\n    Title,\n    Tooltip,\n    Legend,\n    BarElement,\n    CategoryScale,\n    LinearScale\n} from 'chart.js';\nimport { Bar } from 'vue-chartjs';\n\nChartJS.register(CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend);\n\nexport default {\n    name: 'ChartView',\n    components: {\n        Bar\n    },\n    props: {\n        products: { type: String, required: true }\n    },\n    computed: {\n        chartData() {\n            return {\n                labels: this.products.map(item => `${item.brand} - (${item.model})`),\n                datasets: [\n                    {\n                        label: 'Score (0-100)',\n                        backgroundColor: '#2563eb',\n                        data: this.products.map(item => item.score)\n                    },\n                    {\n                        label: 'TTR (Days)',\n                        backgroundColor: '#f59e0b',\n                        data: this.products.map(item => item.ttr_days)\n                    }\n                ]\n            };\n        },\n        chartOptions() {\n            return {\n                responsive: true,\n                maintainAspectRatio: false,\n                plugins: {\n                    legend: { position: 'top' },\n                    tooltip: { enabled: true }\n                },\n                scales: {\n                    y: { beginAtZero: true }\n                }\n            };\n        }\n    }\n}\n</script>\n\n<style scoped>\n.chart-wrapper {\n    position: relative;\n    height: 320px;\n    width: 100%;\n}\n\n;\n\n.chart-box {\n    height: 100%;\n    width: 100%;\n    transition: filter 0.3s ease;\n}\n\n.chart-box.is-blurred {\n    filter: blur(8px);\n    pointer-events: none;\n    user-select: none;\n}\n</style>"],"mappings":";;AAsBA,SACIA,KAAI,IAAKC,OAAO,EAChBC,KAAK,EACLC,OAAO,EACPC,MAAM,EACNC,UAAU,EACVC,aAAa,EACbC,WAAU,QACP,UAAU;AACjB,SAASC,GAAE,QAAS,aAAa;AAEjCP,OAAO,CAACQ,QAAQ,CAACH,aAAa,EAAEC,WAAW,EAAEF,UAAU,EAAEH,KAAK,EAAEC,OAAO,EAAEC,MAAM,CAAC;AAEhF,eAAe;EACXM,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACRH;EACJ,CAAC;EACDI,KAAK,EAAE;IACHC,QAAQ,EAAE;MAAEC,IAAI,EAAEC,MAAM;MAAEC,QAAQ,EAAE;IAAK;EAC7C,CAAC;EACDC,QAAQ,EAAE;IACNC,SAASA,CAAA,EAAG;MACR,OAAO;QACHC,MAAM,EAAE,IAAI,CAACN,QAAQ,CAACO,GAAG,CAACC,IAAG,IAAK,GAAGA,IAAI,CAACC,KAAK,OAAOD,IAAI,CAACE,KAAK,GAAG,CAAC;QACpEC,QAAQ,EAAE,CACN;UACIC,KAAK,EAAE,eAAe;UACtBC,eAAe,EAAE,SAAS;UAC1BC,IAAI,EAAE,IAAI,CAACd,QAAQ,CAACO,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACO,KAAK;QAC9C,CAAC,EACD;UACIH,KAAK,EAAE,YAAY;UACnBC,eAAe,EAAE,SAAS;UAC1BC,IAAI,EAAE,IAAI,CAACd,QAAQ,CAACO,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACQ,QAAQ;QACjD;MAER,CAAC;IACL,CAAC;IACDC,YAAYA,CAAA,EAAG;MACX,OAAO;QACHC,UAAU,EAAE,IAAI;QAChBC,mBAAmB,EAAE,KAAK;QAC1BC,OAAO,EAAE;UACLC,MAAM,EAAE;YAAEC,QAAQ,EAAE;UAAM,CAAC;UAC3BC,OAAO,EAAE;YAAEC,OAAO,EAAE;UAAK;QAC7B,CAAC;QACDC,MAAM,EAAE;UACJC,CAAC,EAAE;YAAEC,WAAW,EAAE;UAAK;QAC3B;MACJ,CAAC;IACL;EACJ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}