/ICRT/ICRT_task/src/components/ChartView.vue"],"sourcesContent":["<template>\n    <div class=\"chart-wrapper\">\n        <div class=\"chart-box\" :class=\"{ 'is-blurred': selectedUser === 'basic' }\">\n            <Bar :data=\"chartData\" :options=\"chartOptions\" />\n        </div>\n\n        <div v-if=\"selectedUser === 'basic'\" class=\"gate-overlay\">\n            <div class=\"gate-card\">\n                <span class=\"gate-icon\">🔒</span>\n                <h3>Detailed Chart Locked</h3>\n                <p>You are on the <strong>Basic Tier</strong>. Upgrade to <strong>Premium</strong> or\n                    <strong>Enterprise</strong> to interact with granular product charts.\n                </p>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nimport {\n    Chart as ChartJS,\n    Title,\n    Tooltip,\n    Legend,\n    BarElement,\n    CategoryScale,\n    LinearScale\n} from 'chart.js';\nimport { Bar } from 'vue-chartjs';\n\nChartJS.register(CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend);\n\nexport default {\n    name: 'ChartView',\n    components: {\n        Bar\n    },\n    props: {\n        products: { type: String, required: true },\n        selectedUser: { type: String, required: true }\n    },\n    computed: {\n        chartData() {\n            return {\n                labels: this.products.map(item => `${item.brand} - (${item.model})`),\n                datasets: [\n                    {\n                        label: 'Score (0-100)',\n                        backgroundColor: '#2563eb',\n                        data: this.products.map(item => item.score)\n                    },\n                    {\n                        label: 'TTR (Days)',\n                        backgroundColor: '#f59e0b',\n                        data: this.products.map(item => item.ttr_days)\n                    }\n                ]\n            };\n        },\n        chartOptions() {\n            return {\n                responsive: true,\n                maintainAspectRatio: false,\n                plugins: {\n                    legend: { position: 'top' },\n                    tooltip: { enabled: true }\n                },\n                scales: {\n                    y: { beginAtZero: true }\n                }\n            };\n        }\n    }\n}\n</script>\n\n<style scoped>\n.chart-wrapper {\n    position: relative;\n    height: 320px;\n    width: 100%;\n}\n\n;\n\n.chart-box {\n    height: 100%;\n    width: 100%;\n    transition: filter 0.3s ease;\n}\n\n.chart-box.is-blurred {\n    filter: blur(8px);\n    pointer-events: none;\n    user-select: none;\n}\n\n.gate-overlay {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: rgba(255, 255, 255, 0.5);\n}\n\n.gate-card {\n    background: #ffffff;\n    border: 1px solid #e2e8f0;\n    border-radius: 10px;\n    padding: 1.5rem 2rem;\n    text-align: center;\n    max-width: 400px;\n    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);\n}\n\n.gate-icon {\n    font-size: 1.8rem;\n}\n\n.gate-card h3 {\n    margin: 0.5rem 0;\n    font-size: 1.1rem;\n}\n\n.gate-card p {\n    margin: 0 0 1rem;\n    font-size: 0.85rem;\n    color: #64748b;\n    line-height: 1.4;\n}\n\n.btn-upgrade {\n    background: #2563eb;\n    color: white;\n    border: none;\n    padding: 0.5rem 1rem;\n    border-radius: 6px;\n    font-size: 0.85rem;\n    font-weight: 600;\n    cursor: pointer;\n}\n\n.btn-upgrade:hover {\n    background: #1d4ed8;\n}\n</style>"],"mappings":";;EACSA,KAAK,EAAC;AAAe;;;EAKeA,KAAK,EAAC;;;;uBAL/CC,mBAAA,CAcM,OAdNC,UAcM,GAbFC,mBAAA,CAEM;IAFDH,KAAK,EAAAI,eAAA,EAAC,WAAW;MAAA,cAAyBC,MAAA,CAAAC,YAAY;IAAA;MACvDC,YAAA,CAAiDC,cAAA;IAA3CC,IAAI,EAAEC,QAAA,CAAAC,SAAS;IAAGC,OAAO,EAAEF,QAAA,CAAAG;iEAG1BR,MAAA,CAAAC,YAAY,gB,cAAvBL,mBAAA,CAQM,OARNa,UAQM,OAAAC,MAAA,QAAAA,MAAA,OAPFZ,mBAAA,CAMM;IANDH,KAAK,EAAC;EAAW,IAClBG,mBAAA,CAAiC;IAA3BH,KAAK,EAAC;EAAW,GAAC,IAAE,GAC1BG,mBAAA,CAA8B,YAA1B