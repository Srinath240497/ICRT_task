{"ast":null,"code":"import HeaderNav from './components/HeaderNav.vue';\nimport AggregateStats from './components/Stats.vue';\nimport DownloadPanel from './components/DownloadPanel.vue';\nimport ChartView from './components/ChartView.vue';\nimport rawData from './constants/data';\nconst API_BASE = 'http://localhost:3000/api';\nexport default {\n  name: 'App',\n  components: {\n    HeaderNav,\n    AggregateStats,\n    DownloadPanel,\n    ChartView\n  },\n  data() {\n    return {\n      rawData,\n      selectedUser: \"basic\",\n      token: '',\n      message: ''\n    };\n  },\n  methods: {\n    handleDownload() {\n      if (this.selectedUser !== 'enterprise') return;\n    },\n    async switchRoleApi(role) {\n      try {\n        const response = await fetch(`${API_BASE}/auth/switch-role`, {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            role\n          })\n        });\n      } catch (err) {}\n    }\n  },\n  watch: {\n    selectedUser(newRole) {\n      this.switchRoleApi(newRole);\n    }\n  },\n  computed: {}\n};","map":{"version":3,"names":["HeaderNav","AggregateStats","DownloadPanel","ChartView","rawData","API_BASE","name","components","data","selectedUser","token","message","methods","handleDownload","switchRoleApi","role","response","fetch","method","headers","body","JSON","stringify","err","watch","newRole","computed"],"sources":["/Users/chill/Documents/ICRT/ICRT_task/frontend/src/App.vue"],"sourcesContent":["<template>\n  <div class=\"dashboard-wrapper\">\n    <HeaderNav :category=\"rawData?.category\" v-model=\"selectedUser\" />\n\n    <AggregateStats :stats=\"rawData?.aggregate_stats\" />\n\n    <main class=\"main-panel\">\n\n      <DownloadPanel :selectedUser=\"selectedUser\" @download=\"handleDownload\" />\n      <ChartView :products=\"rawData?.products\" :selectedUser=\"selectedUser\" />\n      <div>\n        <div>\n          <Bar />\n        </div>\n      </div>\n\n    </main>\n\n  </div>\n</template>\n\n<script>\nimport HeaderNav from './components/HeaderNav.vue';\nimport AggregateStats from './components/Stats.vue';\nimport DownloadPanel from './components/DownloadPanel.vue';\nimport ChartView from './components/ChartView.vue';\nimport rawData from './constants/data';\n\nconst API_BASE = 'http://localhost:3000/api';\n\nexport default {\n  name: 'App',\n  components: {\n    HeaderNav,\n    AggregateStats,\n    DownloadPanel,\n    ChartView\n  },\n  data() {\n    return {\n      rawData,\n      selectedUser: \"basic\",\n      token: '',\n      message: ''\n    };\n  },\n  methods: {\n    handleDownload() {\n      if (this.selectedUser !== 'enterprise') return;\n    },\n    async switchRoleApi(role) {\n      try {\n        const response = await fetch(`${API_BASE}/auth/switch-role`, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ role })\n        });\n      } catch (err) {\n\n      }\n    }\n  },\n  watch: {\n    selectedUser(newRole) {\n      this.switchRoleApi(newRole);\n    }\n  },\n  computed: {\n\n  }\n}\n</script>\n\n<style scoped>\n.dashboard-wrapper {\n  max-width: 950px;\n  margin: 2rem auto;\n  padding: 0 1.5rem;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  color: #1e293b;\n}\n\n.main-panel {\n  background: #ffffff;\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n  padding: 1.5rem;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);\n}\n</style>\n"],"mappings":"AAsBA,OAAOA,SAAQ,MAAO,4BAA4B;AAClD,OAAOC,cAAa,MAAO,wBAAwB;AACnD,OAAOC,aAAY,MAAO,gCAAgC;AAC1D,OAAOC,SAAQ,MAAO,4BAA4B;AAClD,OAAOC,OAAM,MAAO,kBAAkB;AAEtC,MAAMC,QAAO,GAAI,2BAA2B;AAE5C,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IACVP,SAAS;IACTC,cAAc;IACdC,aAAa;IACbC;EACF,CAAC;EACDK,IAAIA,CAAA,EAAG;IACL,OAAO;MACLJ,OAAO;MACPK,YAAY,EAAE,OAAO;MACrBC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,cAAcA,CAAA,