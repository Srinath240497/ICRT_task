{"ast":null,"code":"import { Chart as ChartJS, Title, Tooltip, Legend, BarElement, CategoryScale, LinearScale } from 'chart.js';\nimport { Bar } from 'vue-chartjs';\nChartJS.register(CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend);\nexport default {\n  name: 'ChartView',\n  components: {\n    Bar\n  },\n  props: {}\n};","map":{"version":3,"names":["Chart","ChartJS","Title","Tooltip","Legend","BarElement","CategoryScale","LinearScale","Bar","register","name","components","props"],"sources":["/Users/chill/Documents/ICRT/ICRT_task/src/components/ChartView.vue"],"sourcesContent":["<template>\n    <div class=\"chart-wrapper\">\n        <div class=\"chart-box\" :class=\"{ 'is-blurred': selectedTier === 'Basic' }\">\n            <Bar :data=\"chartData\" :options=\"chartOptions\" />\n        </div>\n\n        <div v-if=\"selectedTier === 'Basic'\" class=\"gate-overlay\">\n            <div class=\"gate-card\">\n                <span class=\"gate-icon\">🔒</span>\n                <h3>Detailed Chart Locked</h3>\n                <p>You are on the <strong>Basic Tier</strong>. Upgrade to <strong>Premium</strong> or\n                    <strong>Enterprise</strong> to interact with granular product charts.\n                </p>\n                <button class=\"btn-upgrade\" @click=\"selectedTier = 'Premium'\">\n                    Switch to Premium\n                </button>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nimport {\n    Chart as ChartJS,\n    Title,\n    Tooltip,\n    Legend,\n    BarElement,\n    CategoryScale,\n    LinearScale\n} from 'chart.js';\nimport { Bar } from 'vue-chartjs';\n\nChartJS.register(CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend);\n\nexport default {\n    name: 'ChartView',\n    components: {\n        Bar\n    },\n    props: {\n\n    }\n}\n</script>\n\n<style scoped>\n.chart-wrapper {\n    position: relative;\n    height: 320px;\n    width: 100%;\n};\n\n.chart-box {\n    height: 100%;\n    width: 100%;\n    transition: filter 0.3s ease;\n}\n\n.chart-box.is-blurred {\n    filter: blur(8px);\n    pointer-events: none;\n    user-select: none;\n}\n</style>"],"mappings":"AAsBA,SACIA,KAAI,IAAKC,OAAO,EAChBC,KAAK,EACLC,OAAO,EACPC,MAAM,EACNC,UAAU,EACVC,aAAa,EACbC,WAAU,QACP,UAAU;AACjB,SAASC,GAAE,QAAS,aAAa;AAEjCP,OAAO,CAACQ,QAAQ,CAACH,aAAa,EAAEC,WAAW,EAAEF,UAAU,EAAEH,KAAK,EAAEC,OAAO,EAAEC,MAAM,CAAC;AAEhF,eAAe;EACXM,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACRH;EACJ,CAAC;EACDI,KAAK,EAAE,CAEP;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}